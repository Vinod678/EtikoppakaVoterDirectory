<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: deep blue with a very subtle top-to-bottom gradient (matches the app header).
     108 x 108 dp adaptive-icon layer. The symbol stays within ~30 dp of the centre, inside the
     66 dp safe zone, so no launcher mask (circle, squircle, rounded square) crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:startColor="#FF1C5BC4"
                android:endColor="#FF0D3B8C" />
        </aapt:attr>
    </path>
</vector>
